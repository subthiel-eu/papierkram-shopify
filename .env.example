# --- Shopify App ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel.example.com
SCOPES=read_orders,write_orders,read_draft_orders,write_draft_orders,read_customers,write_customers,read_products

# --- Datenbank ---
# SQLite reicht fuer Einzelshop-Betrieb. Fuer Produktion Postgres/MySQL
# in prisma/schema.prisma eintragen und DATABASE_URL anpassen.
# Pfad ist relativ zu prisma/schema.prisma
DATABASE_URL="file:./dev.sqlite"

# --- Verschluesselung des Papierkram-API-Tokens ---
# 32 Byte, base64-kodiert. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAPIERKRAM_ENCRYPTION_KEY=

# --- Optional ---
# Abweichender Papierkram-Host (Standard: https://<subdomain>.papierkram.de)
# PAPIERKRAM_BASE_URL_TEMPLATE=https://{subdomain}.papierkram.de
# Sekundenintervall des internen Job-Workers (Standard: 15)
# SYNC_WORKER_INTERVAL=15
