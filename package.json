{
  "name": "papierkram-shopify",
  "version": "1.0.0",
  "private": true,
  "description": "Shopify <-> Papierkram.de Integration: Rechnungen, Angebote, Kontakte, inkl. Admin-Blocks fuer Bestellungen und Kunden",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma": "prisma",
    "typecheck": "tsc --noEmit && npm run typecheck:extensions",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:extensions": "for d in extensions/*/; do [ -f \"$d/tsconfig.json\" ] || continue; echo \"$d\" && (cd \"$d\" && tsc --noEmit -p tsconfig.json) || exit 1; done"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@remix-run/dev": "^2.15.2",
    "@remix-run/node": "^2.15.2",
    "@remix-run/react": "^2.15.2",
    "@remix-run/serve": "^2.15.2",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/shopify-api": "^14.0.1",
    "@shopify/shopify-app-remix": "^5.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.1",
    "isbot": "^5.1.19",
    "prisma": "^6.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/polaris-types": "^1.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "extensions/*"
  ]
}
