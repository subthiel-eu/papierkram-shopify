// Datenmodell der Papierkram <-> Shopify Integration.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Von @shopify/shopify-app-session-storage-prisma vorgegebenes Schema.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

/// Pro Shop genau ein Einstellungs-Datensatz.
model ShopSettings {
  id        String @id @default(cuid())
  shop      String @unique

  // --- Papierkram Zugang ---
  /// Subdomain, z.B. "meinefirma" fuer https://meinefirma.papierkram.de
  subdomain        String?
  /// AES-256-GCM verschluesselter API-Token.
  apiTokenCipher   String?
  /// Zeitpunkt der letzten erfolgreichen Verbindungspruefung.
  connectionOkAt   DateTime?
  /// Letzter bekannter Stand des X-Remaining-Quota Headers.
  remainingQuota   Int?

  // --- Belegerzeugung ---
  /// Voreinstellung, was mit automatisch erzeugten Belegen passiert:
  /// draft | pdf | email. Einzelne Webhook-Regeln koennen das ueberschreiben.
  invoiceMode      String  @default("draft")
  /// Papierkram Zahlungsbedingung (Pflichtfeld beim Anlegen einer Rechnung).
  paymentTermId    Int?
  /// Optionales Rechnungs-Template.
  invoiceTemplateId  Int?
  /// Optionales Angebots-Template.
  estimateTemplateId Int?
  /// Optionales Papierkram-Projekt, dem Belege zugeordnet werden.
  projectId        Int?

  // --- Betraege ---
  /// Belege in Brutto (true) oder Netto (false) ausweisen.
  /// "auto" uebernimmt die Einstellung des Shops (taxesIncluded).
  grossMode        String  @default("auto")
  /// Standard-USt-Satz, wenn Shopify keine Steuerzeile liefert.
  defaultVatRate   Float   @default(19)
  /// Waehrung, in der der Papierkram-Mandant gefuehrt wird. Die API
  /// uebernimmt keine Waehrungsangabe je Beleg, deshalb muessen Shop und
  /// Mandant zusammenpassen.
  documentCurrency String  @default("EUR")
  /// Bestellungen in abweichender Waehrung trotzdem uebertragen. Aus gutem
  /// Grund aus: die Betraege landen sonst unkommentiert als documentCurrency
  /// in der Buchhaltung.
  allowForeignCurrency Boolean @default(false)
  /// Versandkosten als eigene Position aufnehmen.
  includeShipping  Boolean @default(true)
  /// Bezeichnung der Versandposition.
  shippingLabel    String  @default("Versandkosten")
  /// Trinkgeld/Tip als eigene Position aufnehmen.
  includeTips      Boolean @default(true)
  /// Rabatte als Positionsrabatt uebernehmen.
  applyDiscounts   Boolean @default(true)

  // --- Kontakte ---
  /// Shopify-Kunden als Papierkram-Unternehmen anlegen/aktualisieren.
  syncCustomers    Boolean @default(true)
  /// Bestehende Papierkram-Kontakte bei Aenderungen ueberschreiben.
  updateCustomers  Boolean @default(false)
  /// Kunden ohne Firmenname unter "Vorname Nachname" anlegen.
  fallbackToPersonName Boolean @default(true)

  // --- Versandtexte ---
  /// Betreff und Text beim Versand per E-Mail. Platzhalter:
  /// {{beleg_nr}}, {{kunde}}, {{summe}}, {{shop}}, {{bestellung}}
  invoiceEmailSubject  String @default("Ihre Rechnung {{beleg_nr}}")
  invoiceEmailBody     String @default("Guten Tag,\n\nim Anhang finden Sie Ihre Rechnung {{beleg_nr}}. Bitte beachten Sie die Zahlungsmodalitaeten im Dokument.\n\nVielen Dank fuer Ihren Auftrag!")
  estimateEmailSubject String @default("Ihr Angebot {{beleg_nr}}")
  estimateEmailBody    String @default("Guten Tag,\n\nim Anhang finden Sie unser Angebot {{beleg_nr}}. Bei Rueckfragen melden Sie sich gerne.\n\nMit freundlichen Gruessen")

  // --- Steuerung ueber Bestell-Tags ---
  /// Bestellungen mit diesem Tag werden nie uebertragen.
  skipTag  String @default("papierkram:skip")
  /// Bestellungen mit diesem Tag werden uebertragen, auch ohne passenden Ausloeser.
  forceTag String @default("papierkram:invoice")

  // --- Steuerfaelle ---
  /// Sitzland des Haendlers als ISO-Code. Entscheidet, was Inland ist.
  homeCountry          String  @default("DE")
  /// standard | kleinunternehmer (§ 19 UStG)
  taxScheme            String  @default("standard")
  /// Innergemeinschaftliche B2B-Lieferung mit 0 % und Pflichthinweis.
  reverseChargeEnabled Boolean @default(true)
  reverseChargeNote    String  @default("Steuerschuldnerschaft des Leistungsempfaengers (Reverse Charge) gemaess Art. 196 MwStSystRL.")
  kleinunternehmerNote String  @default("Gemaess § 19 UStG wird keine Umsatzsteuer berechnet.")
  /// auto | order_attribute | order_metafield | customer_metafield | none
  vatIdSource          String  @default("auto")
  /// Schluessel bzw. namespace.key, je nach Quelle.
  vatIdKey             String  @default("vat_id")

  // --- Statusabgleich (Papierkram -> Shopify) ---
  reconcileEnabled       Boolean   @default(false)
  reconcileIntervalHours Int       @default(6)
  reconcileLastRunAt     DateTime?
  paidTag                String    @default("papierkram:bezahlt")
  overdueTag             String    @default("papierkram:ueberfaellig")

  // --- Sonstiges ---
  /// Belegname, unterstuetzt {{order_name}}, {{order_number}}, {{shop}}, {{customer}}
  documentNameTemplate String @default("Shopify Bestellung {{order_name}}")
  /// Metafelder auf Bestellung/Kunde zurueckschreiben.
  writeMetafields  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Welcher Shopify-Webhook loest welchen Geschaeftsfall aus.
/// Der Katalog der gueltigen Kombinationen steht in app/sync/business-cases.ts.
model WebhookRule {
  id   String @id @default(cuid())
  shop String

  /// invoice_create | estimate_create | customer_sync | document_refresh |
  /// refund_notice | cancel_notice
  businessCase String
  /// Shopify-Topic, z.B. "orders/paid".
  topic        String

  enabled      Boolean @default(false)
  /// Verzoegerung, bevor der Job laeuft. Nuetzlich bei Entwuerfen, die im
  /// Admin noch zusammengeklickt werden.
  delaySeconds Int     @default(0)
  /// Ueberschreibt ShopSettings.invoiceMode fuer genau diesen Ausloeser.
  /// null = Voreinstellung des Shops verwenden.
  mode         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, businessCase, topic])
  @@index([shop, topic, enabled])
}

/// Verknuepfung zwischen einem Shopify-Objekt und einem Papierkram-Beleg/Kontakt.
model DocumentLink {
  id   String @id @default(cuid())
  shop String

  /// invoice | estimate | company
  kind         String
  /// GID des Shopify-Objekts, z.B. gid://shopify/Order/123
  shopifyGid   String
  /// Zusaetzliche, menschenlesbare Referenz (Bestellnummer, Kundenname).
  shopifyLabel String?

  papierkramId  Int
  /// Belegnummer bzw. Kundennummer, sobald vergeben.
  documentNo    String?
  /// draft | open | paid | cancelled ... (Rohwert aus Papierkram)
  state         String?
  totalGross    Float?
  currency      String?
  /// Direktlink in die Papierkram-Oberflaeche.
  url           String?
  /// Pruefsumme der zuletzt geschriebenen Metafelder. Verhindert, dass ein
  /// Statusabgleich Metafelder neu schreibt, Shopify daraufhin orders/updated
  /// feuert und damit den naechsten Abgleich ausloest.
  metafieldsHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, kind, shopifyGid])
  @@index([shop, kind])
  @@index([shop, papierkramId])
}

/// Auftragswarteschlange: Webhooks quittieren sofort, die Arbeit passiert hier.
model SyncJob {
  id   String @id @default(cuid())
  shop String

  /// order_invoice | draft_order_estimate | customer_upsert | refresh_document
  type    String
  /// JSON-Payload des Jobs.
  payload String
  /// pending | running | done | failed
  status  String @default("pending")

  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  /// Zeitpunkt, zu dem der Job auf "running" gesetzt wurde. Stirbt der
  /// Prozess mittendrin, erkennt der Worker den Job daran wieder.
  startedAt   DateTime?
  lastError   String?
  /// Verhindert doppelte Jobs fuer dasselbe Objekt.
  dedupeKey   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, dedupeKey])
  @@index([status, runAfter])
  @@index([shop, status])
}

/// Protokoll fuer die Admin-Oberflaeche.
model LogEntry {
  id   String @id @default(cuid())
  shop String

  /// info | warning | error
  level   String
  /// Kurzer Vorgang, z.B. "invoice.create"
  action  String
  message String
  /// Optionales JSON mit Kontext.
  context String?

  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, level])
}

/// Ein Nachtrag historischer Bestellungen.
model BackfillRun {
  id   String @id @default(cuid())
  shop String

  /// pending | running | done | failed
  status String @default("pending")

  fromDate DateTime
  toDate   DateTime
  /// Nur bezahlte Bestellungen beruecksichtigen.
  onlyPaid Boolean @default(true)
  /// Bestellungen ueberspringen, zu denen es schon einen Beleg gibt.
  skipExisting Boolean @default(true)

  /// GID der Shopify-Massenabfrage, solange sie laeuft.
  bulkOperationId String?
  /// Schaetzung vor dem Start.
  estimatedOrders Int?
  /// Tatsaechlich gelieferte Bestellungen.
  foundOrders     Int?
  /// Davon eingeplant (der Rest hatte bereits einen Beleg).
  queuedOrders    Int?
  error           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, status])
  @@index([bulkOperationId])
}

/// Zuordnung Shopify-Produkt/Variante -> Papierkram Position (Proposition).
model PropositionMapping {
  id   String @id @default(cuid())
  shop String

  /// GID der Variante oder des Produkts.
  shopifyGid    String
  shopifyLabel  String?
  propositionId Int
  propositionNo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, shopifyGid])
}
